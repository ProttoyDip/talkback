# Copy to backend/.env and fill in. Never commit backend/.env (SECURITY.md T6).

# Signs short-lived session tokens. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random secret is generated at startup (tokens stop working after a restart).
SESSION_SECRET=

# Comma-separated browser origins allowed to open the session WebSocket.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nebius Token Factory key for the Nemotron planner (not used yet).
NEBIUS_API_KEY=

# Tavily web search key (not used yet).
TAVILY_API_KEY=

# Private-network WebSocket URL of the VoiceChat container (not used yet).
VOICECHAT_URL=

# Voice engine: cascade (plan B), fake, voicechat, or none.
VOICE_ENGINE=cascade

# Plan B speech models on the NVIDIA API catalog (build.nvidia.com).
# Get a key at https://build.nvidia.com (free credits). The IDs below are defaults.
NVIDIA_API_KEY=
RIVA_SERVER=grpc.nvcf.nvidia.com:443
ASR_FUNCTION_ID=d8dd4e9b-fbf5-4fb0-9dba-8cf436c8d965
TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
TTS_VOICE=Magpie-Multilingual.EN-US.Leo

# Backup language model provider (used if Nebius fails or has no key).
OPENROUTER_API_KEY=
