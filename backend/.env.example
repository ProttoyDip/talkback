# Copy to backend/.env and fill in. Never commit backend/.env (SECURITY.md T6).

# Signs short-lived session tokens. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random secret is generated at startup (tokens stop working after a restart).
SESSION_SECRET=

# Comma-separated browser origins allowed to open the session WebSocket.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nebius Token Factory key for the Nemotron planner (not used yet).
NEBIUS_API_KEY=

# Tavily web search key (not used yet).
TAVILY_API_KEY=

# Private-network WebSocket URL of the VoiceChat container (not used yet).
VOICECHAT_URL=
